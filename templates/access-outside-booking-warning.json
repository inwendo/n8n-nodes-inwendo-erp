        "width": 560
      },
      "id": "38925d99-6684-55f4-902c-c310f6df2103",
      "name": "About this template",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -200,
        -260
      ]
    },
