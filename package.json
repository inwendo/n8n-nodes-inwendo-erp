{
	"name": "n8n-nodes-inwendo-erp",
	"version": "0.1.0",
	"description": "n8n community node for inwendo ERP integration",
	"keywords": [
		"n8n-community-node-package"
	],
	"license": "MIT",
	"homepage": "",
	"author": {
		"name": "inwendo GmbH"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/inwendo/n8n-nodes-inwendo-erp.git"
	},
	"main": "index.js",
	"scripts": {
		"build": "tsc && gulp build:icons",
		"dev": "tsc --watch",
		"format": "prettier nodes credentials --write",
		"lint": "eslint nodes credentials package.json",
		"lintfix": "eslint nodes credentials package.json --fix",
		"prepublishOnly": "npm run build"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/InwendoErpApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/InwendoErp/InwendoErp.node.js",
			"dist/nodes/InwendoErp/InwendoErpTrigger.node.js"
		]
	},
	"devDependencies": {
		"@typescript-eslint/parser": "^7.0.0",
		"eslint": "^8.56.0",
		"gulp": "^5.0.1",
		"n8n-workflow": "*",
		"prettier": "^3.2.0",
		"typescript": "^5.3.0"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
