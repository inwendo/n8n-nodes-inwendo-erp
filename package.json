{
	"name": "n8n-nodes-inwendo-erp",
	"version": "0.6.0",
	"description": "n8n community nodes for vynst (inwendo ERP): members, bookings, events, tickets, invoices and smart locks",
	"keywords": [
		"n8n-community-node-package",
		"vynst",
		"inwendo",
		"erp",
		"club-management"
	],
	"license": "MIT",
	"homepage": "https://developer.vynst.de/en/integrations/n8n/",
	"engines": {
		"node": ">=20.19"
	},
	"author": {
		"name": "inwendo GmbH",
		"email": "enno@inwendo.de"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/inwendo/n8n-nodes-inwendo-erp.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"format": "prettier nodes credentials --write",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"test": "npm run build && node --test \"test/unit/*.test.js\"",
		"test:e2e": "npm run build && node --test \"test/e2e/*.test.js\""
	},
	"files": [
		"dist",
		"templates",
		"!dist/**/*.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/InwendoErpApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/InwendoErp/InwendoErp.node.js",
			"dist/nodes/InwendoErp/InwendoErpTrigger.node.js",
			"dist/nodes/InwendoErp/InwendoErpLockTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.54.3",
		"@types/node": "^18.19.130",
		"eslint": "^9.39.4",
		"n8n-workflow": ">=3.0.0",
		"prettier": "^3.8.3",
		"release-it": "^20.2.0",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
